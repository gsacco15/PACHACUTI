<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Approximate C# type-check of the Unity runtime and editor scripts without a
    Unity licence (for headless sessions and quick local checks).

      dotnet build tools/UnityCompileCheck                    runtime + core (player build)
      dotnet build tools/UnityCompileCheck -p:UnityEditor=true  + editor scripts and PlayMode tests

    It compiles against community-published Unity reference assemblies from
    NuGet (UnityEngine.Modules 2021.3, Unity3D.SDK 2021.1 for UnityEditor) plus
    Stubs/PackageStubs.cs for the Input System and URP members the project
    uses. The real check is still the Unity Editor: APIs newer than 2021.3 will
    show as false errors here, so the project sticks to long-stable APIs.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CS0649;CS0414;NU1701</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UnityEditor Condition="'$(UnityEditor)' == ''">false</UnityEditor>
    <DefineConstants>UNITY_2021_3_OR_NEWER;UNITY_6000_0_OR_NEWER;ENABLE_INPUT_SYSTEM</DefineConstants>
    <DefineConstants Condition="'$(UnityEditor)' == 'true'">$(DefineConstants);UNITY_EDITOR;UNITY_INCLUDE_TESTS;PACHACUTI_COMPILECHECK_TESTS</DefineConstants>
    <AssemblyName Condition="'$(UnityEditor)' == 'true'">UnityCompileCheck.Editor</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" ExcludeAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="Unity3D.SDK" Version="2021.1.14.1" ExcludeAssets="all" GeneratePathProperty="true" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Stubs/**/*.cs" />
    <Compile Include="../../Assets/Pachacuti/Scripts/Core/**/*.cs" />
    <Compile Include="../../Assets/Pachacuti/Scripts/Runtime/**/*.cs" />
    <Compile Include="../../Assets/Pachacuti/Scripts/Editor/**/*.cs" Condition="'$(UnityEditor)' == 'true'" />
    <Compile Include="../../Assets/Pachacuti/Tests/PlayMode/**/*.cs" Condition="'$(UnityEditor)' == 'true'" />
  </ItemGroup>
  <ItemGroup Condition="'$(UnityEditor)' == 'true'">
    <PackageReference Include="NUnit" Version="3.14.0" />
  </ItemGroup>
  <Target Name="AddUnityReferences" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <UnityModule Include="$(PkgUnityEngine_Modules)/lib/netstandard2.0/UnityEngine.*.dll" />
      <Reference Include="@(UnityModule)" Private="false" />
      <Reference Include="$(PkgUnity3D_SDK)/lib/UnityEditor.dll" Private="false" Condition="'$(UnityEditor)' == 'true'" />
      <!-- UnityEditor.dll binds to the UnityEngine facade, which type-forwards to the modules. -->
      <Reference Include="$(PkgUnityEngine_Modules)/lib/netstandard2.0/UnityEngine.dll" Private="false" Condition="'$(UnityEditor)' == 'true'" />
    </ItemGroup>
  </Target>
</Project>
